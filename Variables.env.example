# AI-Mirror settings and keys.
#
# Copy this file to ../Variables.env (the directory ABOVE the checkout) and
# fill in only what you use. That file is never committed. Every value is
# optional: a module without its keys hides itself.
#
# A line written '# NAME=value' shows a built-in default. Uncomment it only to
# change it: an empty NAME= overrides the default with nothing.

# ---- Location --------------------------------------------------------------
# OpenWeatherMap "City,CC", e.g. London,UK
# MIRROR_CITY=London,UK
# house pack location; default ./house (see house_pack.py)
MIRROR_HOUSE_DIR=

# ---- AI and voice ------------------------------------------------------------
OPENAI_API_KEY=
# optional separate key for the realtime voice
OPENAI_VOICE_KEY=
ENABLE_VOICE=
ENABLE_VOICE_FALLBACK=
# gpt-realtime-mini by default
# VOICE_MODEL=gpt-realtime-mini
# VOICE_VOICE=marin
VOICE_PROMPT=
# ALSA capture device, e.g. plughw:3,0
# VOICE_MIC=plughw:3,0
# ALSA playback device for the avatar's sound
VOICE_SPEAKER=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Avatar (Vosk -> OpenAI -> Fal talking video) -----------------------------
# 1 to replace the Realtime voice with the generated-video avatar
ENABLE_AVATAR=
FAL_KEY=
# e.g. /home/pi/models/vosk-model-small-en-us-0.15
VOSK_MODEL_PATH=
# start with this character key from the house pack
AVATAR_CHARACTER=
# AVATAR_LLM_MODEL=gpt-5-nano-2025-08-07
# AVATAR_LLM_REASONING_EFFORT=minimal
# AVATAR_LLM_MAX_OUTPUT_TOKENS=160
# AVATAR_MAX_REPLY_WORDS=8
# AVATAR_FAL_MODEL=minimax/h3-max-turbo/image-to-video
# AVATAR_FAL_RESOLUTION=480P
# AVATAR_FAL_POLL_SECONDS=0.25
# model for avatar_theatre.py clips
# AVATAR_THEATRE_MODEL=fal-ai/kling-video/v2.6/pro/image-to-video
# AVATAR_STREAM_FIRST=0  (1 streams the Fal URL: sooner picture, sound out of sync on the Pi)
# seconds of listening after the second SPACE
# AVATAR_STT_TAIL=0.4
# AVATAR_WARM_MIC=1
# 0 hides the on-glass debug panel
# AVATAR_DEBUG_OVERLAY=1
AVATAR_PROMPT_FILE=
AVATAR_SYSTEM_PROMPT=

# ---- Weather, markets, energy ------------------------------------------------
OPENWEATHERMAP_API_KEY=
ALPHA_VANTAGE_KEY=
OCTOPUS_API_KEY=
OCTOPUS_ACCOUNT_NUMBER=

# ---- Calendar and health (OAuth: run google_reauth.py / auth_fitbit.py) ---------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ACCESS_TOKEN=
GOOGLE_REFRESH_TOKEN=
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_ACCESS_TOKEN=
FITBIT_REFRESH_TOKEN=

# ---- Messages ------------------------------------------------------------------
OPENCLAW_GATEWAY_URL=
OPENCLAW_GATEWAY_TOKEN=

# ---- Home Assistant ------------------------------------------------------------
# e.g. http://homeassistant.local:8123
HA_URL=
# long-lived access token
HA_TOKEN=
# comma-separated, for the smart-home summary
HA_ENTITIES=
HA_LIGHT_ENTITIES=
HA_PRESENCE_ENTITIES=

# ---- Visual gate: Home Assistant entity IDs for the live house ----------------
# motion sensor in front of the mirror (rest / wake)
VISUAL_GATE_ENTRANCE_PIR=
# house power, W (negative when exporting)
VISUAL_GATE_POWER_ENTITY=
VISUAL_GATE_SOLAR_ENTITY=
# comma-separated
VISUAL_GATE_LIGHT_ENTITIES=
VISUAL_GATE_UPSTAIRS_TEMP_ENTITY=
VISUAL_GATE_UPSTAIRS_HUMIDITY_ENTITY=
VISUAL_GATE_DOWNSTAIRS_TEMP_ENTITY=
VISUAL_GATE_DOWNSTAIRS_HUMIDITY_ENTITY=
VISUAL_GATE_LIVINGROOM_LIGHT_ENTITY=
VISUAL_GATE_LIVINGROOM_SPOTLIGHTS_ENTITY=
VISUAL_GATE_LIVINGROOM_LED_ENTITY=
VISUAL_GATE_LIVINGROOM_TV_ENTITY=
VISUAL_GATE_LIVINGROOM_OCCUPANCY_ENTITY=
VISUAL_GATE_LIVINGROOM_CURTAIN_ENTITY=
VISUAL_GATE_HALL_LIGHT_ENTITY=
VISUAL_GATE_PORCH_LIGHT_ENTITY=
VISUAL_GATE_BEDROOM_LIGHT_ENTITY=
VISUAL_GATE_BEDROOM_OCCUPANCY_ENTITY=
VISUAL_GATE_BEDROOM1_LIGHT_ENTITY=
VISUAL_GATE_BEDROOM2_LIGHT_ENTITY=
VISUAL_GATE_BEDROOM3_LIGHT_ENTITY=
VISUAL_GATE_BATHROOM_LIGHT_ENTITY=
VISUAL_GATE_UPSTAIRS_LIGHT_ENTITY=
VISUAL_GATE_UPSTAIRS_OCCUPANCY_ENTITY=
VISUAL_GATE_FRONT_DOOR_CONTACT_ENTITY=
VISUAL_GATE_ALARM_ENTITY=
VISUAL_GATE_DOORBELL_CAMERA_ENTITY=
# person/motion at the entrance
VISUAL_GATE_DOORBELL_PERSON=
VISUAL_GATE_EXTERNAL_CAMERA_ENTITY=
# front exterior motion
VISUAL_GATE_FRONTCAMERA_MOTION=
VISUAL_GATE_CAR_PRESENCE_ENTITY=
VISUAL_GATE_CAR_SOC_ENTITY=
# actual charging state, never a scheduled dispatch
VISUAL_GATE_CAR_CHARGING=
VISUAL_GATE_BATTERY_SOC_ENTITY=
VISUAL_GATE_BATTERY_CHARGING_ENTITY=
# rain probability % that shows the rain alert (55)
# VISUAL_GATE_RAIN_THRESHOLD=55
# 0 turns the avatar off in the visual gate
# VISUAL_GATE_RESIDENT=1

# ---- Night and display ---------------------------------------------------------
# AUTO_SLEEP_ENABLED=1
# AUTO_SLEEP_START_HOUR=1
# AUTO_SLEEP_END_HOUR=5
# AUTO_SLEEP_PRESENCE_MAX_AGE_SECONDS=300
# AUTO_SLEEP_WAKE_GRACE_SECONDS=600
# AUTO_SLEEP_POWER_OFF_DISPLAY=1
UI_BRIGHTNESS=
# UI_DISPLAY_MODE=auto
